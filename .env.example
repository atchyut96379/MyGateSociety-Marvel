APP_NAME=MyGate Society API
APP_ENV=development
AUTO_CREATE_TABLES=true

# Option 1: provide a full SQLAlchemy URL.
# DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@localhost:1433/MyGateSociety?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Option 2: provide SQL Server components and let the app build the URL.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=MyGateSociety
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
